# Dify 앱 API 키 — 서버(API 라우트)에서만 읽는다. NEXT_PUBLIC_ 를 붙이지 말 것 (붙이면 브라우저 번들에 들어감)
# Dify > 패션 추천 봇 앱(20a75a73-2c13-4fc4-b5b6-97775eb88de9) > API 액세스 > API 키 (app-...)
DIFY_API_KEY=
# Dify API 주소 (로컬 docker Dify 기본값)
DIFY_API_URL=http://localhost/v1
# 1이면 Dify 대신 mock/answers.json 예시 답변으로 동작 (화면 확인용)
DIFY_MOCK=0
# 브라우저 저장소에서 대화 ID를 구분하는 값 (비밀 아님)
NEXT_PUBLIC_APP_ID=20a75a73-2c13-4fc4-b5b6-97775eb88de9
